# Claude API (for summarize-gazette.js)
ANTHROPIC_API_KEY=sk-ant-...

# ElevenLabs TTS (optional): generate MP3 audio for each issue summary. Used after .md is written.
# Set ELEVENLABS_ENABLED=false to disable audio (e.g. to save credits); set true or leave unset to enable when key is set.
# ELEVENLABS_ENABLED=true
# Get key at https://elevenlabs.io → Profile → API Key.
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=...          # default voice if unset
# ELEVENLABS_MODEL_ID=...          # default: eleven_multilingual_v2 (best). Or eleven_flash_v2_5 / eleven_turbo_v2_5 for cheaper
# ELEVENLABS_OUTPUT_FORMAT=...     # default: mp3_44100_128. Or mp3_22050_32 to save credits
# ELEVENLABS_MAX_CHARS=5000       # optional: cap text length to stay within quota

# Email on failure: one email per failing run to ALERT_EMAIL (includes last 30 lines from logs/).
# Set ALERT_EMAIL + RESEND_API_KEY; get API key at https://resend.com/api-keys
ALERT_EMAIL=you@example.com
RESEND_API_KEY=re_xxxx
# Optional: SEND_ALERT_EMAILS=true to always send; =false to disable. If unset, sends only when NODE_ENV=production.
# SEND_ALERT_EMAILS=true
# Optional: ALERT_FROM defaults to "Gazette Alerts <onboarding@resend.dev>". Set to use your verified domain.
# ALERT_FROM=alerts@yourdomain.com
