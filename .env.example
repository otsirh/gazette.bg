# Claude API (for summarize-gazette.js)
ANTHROPIC_API_KEY=sk-ant-...

# ElevenLabs Audio Native: embeddable player per issue. Created automatically after each new summary when ELEVENLABS_API_KEY is set; or run: npm run create-audio-native -- 2026 17
# Get key at https://elevenlabs.io → Profile → API Key. Enable Audio Native and whitelist your site at https://elevenlabs.io → Projects → Audio Native.
# ELEVENLABS_API_KEY=...
# For CI (e.g. GitHub Actions): add ELEVENLABS_API_KEY to repo secrets so update-gazette can create Audio Native for new issues.

# Email on failure: one email per failing run to ALERT_EMAIL (includes last 30 lines from logs/).
# Set ALERT_EMAIL + RESEND_API_KEY; get API key at https://resend.com/api-keys
ALERT_EMAIL=you@example.com
RESEND_API_KEY=re_xxxx
# Optional: SEND_ALERT_EMAILS=true to always send; =false to disable. If unset, sends only when NODE_ENV=production.
# SEND_ALERT_EMAILS=true
# Optional: ALERT_FROM defaults to "Gazette Alerts <onboarding@resend.dev>". Set to use your verified domain.
# ALERT_FROM=alerts@yourdomain.com
