# Claude API (for summarize-gazette.js)
ANTHROPIC_API_KEY=sk-ant-...

# Email on failure only: one email per failing run to ALERT_EMAIL (no file logs).
# Set ALERT_EMAIL + RESEND_API_KEY; get API key at https://resend.com/api-keys
ALERT_EMAIL=you@example.com
RESEND_API_KEY=re_xxxx
# Optional: ALERT_FROM defaults to "Gazette Alerts <onboarding@resend.dev>". Set to use your verified domain.
# ALERT_FROM=alerts@yourdomain.com
