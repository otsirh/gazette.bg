{
  "name": "gazette-bg",
  "version": "1.0.0",
  "description": "Plain-language AI summaries of every issue of Bulgaria's State Gazette",
  "homepage": "https://gazette.bg",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-gazette-catalog.js && node scripts/build-issue-pages.js",
    "serve": "npx --yes serve dist -p 3000",
    "dev": "npm run build && npm run serve",
    "download-latest-gazette": "node scripts/download-latest-gazette.js",
    "summarize-gazette": "node scripts/summarize-gazette.js",
    "process-issue-pdf": "node scripts/process-issue-pdf.js",
    "generate-og-image": "node scripts/generate-og-image.js",
    "generate-favicon": "node scripts/generate-favicon.js",
    "update-gazette": "node scripts/update-gazette.js",
    "gazette": "npm run dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "dotenv": "^16.4.5",
    "marked": "^18.0.3",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "playwright": "^1.58.1"
  }
}
