# Cloudflare Pages response headers. The build copies this into dist/.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Cross-Origin-Opener-Policy: same-origin
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# The fonts never change under the same name, so browsers may keep them for a
# year. Give a changed font a new file name.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Every script is loaded by an address that carries a hash of its content
# (?v=…), so a changed script is a new address and these never go stale.
/src/js/*
  Cache-Control: public, max-age=31536000, immutable

# Share pictures are rebuilt with the site; a headline that changes keeps its
# file name, so they are cached for a day rather than for good.
/og/*
  Cache-Control: public, max-age=86400

# The offline worker is checked for a new version on every visit.
/sw.js
  Cache-Control: no-cache
