# Cloudflare Pages response headers. The build copies this into dist/.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# The fonts never change under the same name, so browsers may keep them for a
# year. Give a changed font a new file name.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
